# =============================================================================
# G G O — Ink-Forge Physics Jousting  (Supabase edition)
# Copy to .env.local and fill values. Never commit real secrets.
# =============================================================================

# -----------------------------------------------------------------------------
# Supabase (Required for Online features + profile cloud sync)
# Create project at https://supabase.com → Settings → API
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_public_key

# -----------------------------------------------------------------------------
# WebRTC ICE Servers (JSON array)
# Add TURN for production reliability if needed.
# -----------------------------------------------------------------------------
VITE_RTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"},{"urls":"stun:stun1.l.google.com:19302"}]

# -----------------------------------------------------------------------------
# Public app URL (QR codes / share links)
# Example after Vercel deploy: https://ggo.vercel.app
# -----------------------------------------------------------------------------
VITE_APP_URL=
